# Copy to .env and fill in your values (never commit .env)

# Semantic Scholar — optional but strongly recommended (429 without key)
SEMANTIC_SCHOLAR_API_KEY=your-key-here

# OpenAlex — no API key required.
# Optional: your email for polite-pool rate limits (https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication)
OPENALEX_MAILTO=you@example.com
